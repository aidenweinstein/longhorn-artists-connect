// Secrets.example.xcconfig — TEMPLATE (safe to commit).
// Copy this file to `Secrets.xcconfig` (same folder, next to the .xcodeproj) and paste
// your real CloudKit Web Services API tokens. Secrets.xcconfig is git-ignored.
//
// Create the tokens in the CloudKit Dashboard: your container → Tokens & Keys →
// API Tokens. Tokens are per-environment (a Development token is NOT valid in
// Production), so create one of each.
//
// These become build settings, injected into Info.plist at build time via
// $(CLOUDKIT_API_TOKEN_DEV) / $(CLOUDKIT_API_TOKEN_PROD). A missing Secrets.xcconfig
// makes the "Verify CloudKit Secrets" build phase fail with instructions.
CLOUDKIT_API_TOKEN_DEV = REPLACE_WITH_DEVELOPMENT_TOKEN
CLOUDKIT_API_TOKEN_PROD = REPLACE_WITH_PRODUCTION_TOKEN

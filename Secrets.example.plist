<?xml version="1.0" encoding="UTF-8"?>
<!--
    Template for the app's CloudKit Web Services API tokens.

    Copy this file to:  Longhorn Artists Connect/10) Cloudkit/Secrets.plist
    and replace the placeholders with real tokens. That real Secrets.plist is
    git-ignored (it must never be committed) but is bundled into the app because it
    lives in the synchronized source group.

    API tokens are PER-ENVIRONMENT. Create one in each environment:
      CloudKit Console -> container iCloud.LAA.Longhorn-Artists-Connect
        -> switch the environment selector (Development / Production)
        -> Tokens & Keys -> API Tokens -> new token with public-database read access.
    A Development token is NOT valid in Production and vice versa.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CloudKitAPITokenDevelopment</key>
	<string>REPLACE_WITH_DEVELOPMENT_CLOUDKIT_API_TOKEN</string>
	<key>CloudKitAPITokenProduction</key>
	<string>REPLACE_WITH_PRODUCTION_CLOUDKIT_API_TOKEN</string>
</dict>
</plist>

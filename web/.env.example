# Copy to .env.local and fill in. Never commit .env.local.

# verification-service (Cloudflare Worker) base URL, e.g. https://lac-verification.<account>.workers.dev
# Leave unset in development to use the local stand-in, which prints codes in the terminal.
VERIFICATION_URL=

# Must match the Worker's WEB_CLIENT_TOKEN secret (wrangler secret put WEB_CLIENT_TOKEN).
WEB_CLIENT_TOKEN=

# Random 32+ character string used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Signed-in school emails that can manage the People pages at /admin/people (comma-separated).
ADMIN_EMAILS=

# Cloudflare R2: storage for website uploads over 45 MB (films up to 10 GB), which
# CloudKit Web Services refuses. See lib/r2.ts. Leave unset to keep big uploads off.
# R2_ACCOUNT_ID: the Account ID shown on the R2 overview page.
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: from an R2 API token (Object Read & Write).
# R2_PUBLIC_URL: the bucket's public address, e.g. https://media.nexusbylac.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Sign in with Apple (lib/apple.ts). The Services ID from Apple Developer > Identifiers >
# Services IDs, grouped with the app's App ID, with this site's return URL registered:
# https://nexusbylac.com/auth/apple/callback. Must match APPLE_WEB_CLIENT_ID in
# verification-service/wrangler.toml. Leave unset to hide the Sign in with Apple buttons.
APPLE_WEB_CLIENT_ID=
# Optional: the exact return URL registered on the Services ID, if it isn't this site's
# own /auth/apple/callback (e.g. a preview deployment signing in through production).
APPLE_REDIRECT_URI=

# Copy to .env.local and fill in. Never commit .env.local.

# verification-service (Cloudflare Worker) base URL, e.g. https://lac-verification.<account>.workers.dev
# Leave unset in development to use the local stand-in, which prints codes in the terminal.
VERIFICATION_URL=

# Must match the Worker's WEB_CLIENT_TOKEN secret (wrangler secret put WEB_CLIENT_TOKEN).
WEB_CLIENT_TOKEN=

# Random 32+ character string used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Signed-in school emails that can manage the People pages at /admin/people (comma-separated).
ADMIN_EMAILS=

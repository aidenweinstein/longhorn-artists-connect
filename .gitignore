# macOS
.DS_Store

# Xcode user-specific state (per-developer, not source)
xcuserdata/
*.xcuserstate
*.xcuserdatad

# Build products / derived data
build/
DerivedData/
*.app
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager
.build/
.swiftpm/

# Dependency managers (not used, kept for safety)
Pods/
Carthage/Build/

# Secrets — real API tokens live here, never commit (see Secrets.example.plist / Secrets.example.xcconfig)
Secrets.plist
Secrets.xcconfig

# Keys — the CloudKit server-to-server private key can write verification
# records for any user. Never commit any PEM.
*.pem
*.p8
*.key

# Cloudflare Worker local state
.wrangler/
.dev.vars

# Web app (see NEXUS_WEB_PLAN.md)
web/.secrets/
node_modules/
.next/
.vercel/
*.tsbuildinfo
.env.local

# Local leftovers
*.zip
_backup_*/

*.zip
_backup_*/

*.zip
_backup_*/

# macOS copy junk
._*

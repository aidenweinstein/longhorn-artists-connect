# Copy to .env and fill in. .env is git-ignored (see backend/migration/.gitignore).

# --- CloudKit (read-only) -------------------------------------------------
# Public-database API token from CloudKit Dashboard -> your container ->
# Tokens & Keys -> API Tokens. Tokens are PER-ENVIRONMENT: a Development token
# is not valid in Production. This is the same token the app already reads as
# CloudKitAPITokenProduction (see Secrets.example.xcconfig).
CK_API_TOKEN=
CK_CONTAINER_ID=iCloud.LAA.Longhorn-Artists-Connect
# All real content lives in production. Only change this to export dev-only data.
CK_ENVIRONMENT=production

# --- Supabase -------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
# For a local stack: http://127.0.0.1:54321
SUPABASE_URL=
# SERVICE ROLE key — bypasses RLS. Required, because the loader writes rows on
# behalf of users who have not authenticated yet. NEVER ship this in an app,
# never commit it, and revoke it once the migration is done.
SUPABASE_SERVICE_ROLE_KEY=

# --- Behaviour ------------------------------------------------------------
# Where exported JSON and downloaded assets are written.
EXPORT_DIR=./out
# Parallel asset downloads/uploads. Keep modest; CloudKit rate-limits.
CONCURRENCY=4
# Set to 1 to skip downloading/uploading media (metadata only). Useful for a
# fast structural dry run before committing to a multi-hour asset transfer.
SKIP_ASSETS=0
